APP_PUBLIC_URL=https://studio.cloud-nodes.net
# Exact direct peer observed by the API for host-nginx requests. Keep loopback
# until read-only production evidence identifies a different single IP.
STUDIO_TRUSTED_PROXY_IP=127.0.0.1
# Persist authenticated activity at most once per session in this interval.
STUDIO_SESSION_LAST_SEEN_WRITE_INTERVAL_SECONDS=300
# Terminal login, OAuth-state, and session rows are deleted in bounded batches.
STUDIO_AUTH_CLEANUP_INTERVAL_SECONDS=3600
STUDIO_AUTH_CLEANUP_BATCH_SIZE=500

# Stateful platform-only secret file paths. Values are file paths, not secret contents.
STUDIO_POSTGRES_PASSWORD_FILE=/path/to/studio_postgres_password
# Separate application and protected migration logins. Neither file may reuse
# the bootstrap or worker password.
STUDIO_API_POSTGRES_PASSWORD_FILE=/path/to/studio_api_postgres_password
STUDIO_MIGRATOR_POSTGRES_PASSWORD_FILE=/path/to/studio_migrator_postgres_password
# Dedicated non-superuser worker login. This file must not be the API/PostgreSQL
# bootstrap password file and is mounted into the worker under the generic runtime name.
STUDIO_WORKER_POSTGRES_PASSWORD_FILE=/path/to/studio_worker_postgres_password
STUDIO_RECENT_AUTH_SECONDS=600
STUDIO_CREDENTIAL_MASTER_KEY_FILE=/path/to/studio_credential_master_key

# Transcription-reference storage. Existing legacy objects remain here. Values ending in _FILE are paths to operator-managed secret files, not secret contents.
STUDIO_SOURCE_S3_ENDPOINT_URL=__REQUIRED_TEMP_SOURCE_S3_ENDPOINT_URL__
STUDIO_SOURCE_S3_REGION=__REQUIRED_TEMP_SOURCE_S3_REGION__
STUDIO_SOURCE_S3_BUCKET=__REQUIRED_TEMP_SOURCE_S3_BUCKET__
STUDIO_SOURCE_S3_ACCESS_KEY_ID_FILE=/path/to/studio_source_s3_access_key_id
STUDIO_SOURCE_S3_SECRET_ACCESS_KEY_FILE=/path/to/studio_source_s3_secret_access_key
STUDIO_SOURCE_S3_LIFECYCLE_RULE_ID=transcription-reference-retention

# Audio-processing references use a different bucket, credential pair, and lifecycle policy.
STUDIO_AUDIO_REFERENCE_S3_ENDPOINT_URL=__REQUIRED_AUDIO_REFERENCE_S3_ENDPOINT_URL__
STUDIO_AUDIO_REFERENCE_S3_REGION=__REQUIRED_AUDIO_REFERENCE_S3_REGION__
STUDIO_AUDIO_REFERENCE_S3_BUCKET=__REQUIRED_AUDIO_REFERENCE_S3_BUCKET__
STUDIO_AUDIO_REFERENCE_S3_ACCESS_KEY_ID_FILE=/path/to/studio_audio_reference_s3_access_key_id
STUDIO_AUDIO_REFERENCE_S3_SECRET_ACCESS_KEY_FILE=/path/to/studio_audio_reference_s3_secret_access_key
STUDIO_AUDIO_REFERENCE_S3_LIFECYCLE_RULE_ID=audio-reference-retention
# Unfinished uploads expire after one hour by default.
STUDIO_SOURCE_UPLOAD_TTL_SECONDS=3600
STUDIO_SOURCE_PRESIGN_TTL_SECONDS=900
# Integer bytes in 1..2147483647; the authenticated PWA reads the active value from the API.
STUDIO_SOURCE_MAX_UPLOAD_BYTES=536870912
# The provider is not called above the hard limit. Files over the warning
# threshold require an explicit owner confirmation before they are retried.
STUDIO_MEDIA_DURATION_WARNING_SECONDS=14400
STUDIO_MEDIA_MAX_DURATION_SECONDS=43200
# Provider-specific BYOK gates. Enable Yandex only after an operator has
# accepted its data-processing boundary and configured an owner API key.
STUDIO_ELEVENLABS_BYOK_ENABLED=true
STUDIO_YANDEX_BYOK_ENABLED=false
STUDIO_ELEVENLABS_ECONOMIC_MODEL=scribe_v2
STUDIO_ELEVENLABS_STANDARD_MODEL=scribe_v2
STUDIO_ELEVENLABS_PREMIUM_MODEL=scribe_v2
STUDIO_ELEVENLABS_REALTIME_MODEL=scribe_v2_realtime
STUDIO_YANDEX_ECONOMIC_MODEL=deferred-general
STUDIO_YANDEX_STANDARD_MODEL=general
STUDIO_YANDEX_PREMIUM_MODEL=general
STUDIO_YANDEX_REALTIME_MODEL=general
STUDIO_YANDEX_STT_API_BASE_URL=https://stt.api.cloud.yandex.net
STUDIO_YANDEX_OPERATIONS_API_BASE_URL=https://operation.api.cloud.yandex.net
STUDIO_YANDEX_STT_GRPC_ENDPOINT=stt.api.cloud.yandex.net:443
STUDIO_YANDEX_OPERATION_POLL_INTERVAL_SECONDS=5
STUDIO_YANDEX_OPERATION_TIMEOUT_SECONDS=14400
STUDIO_STT_HEALTH_FAILURE_THRESHOLD=3
STUDIO_STT_HEALTH_COOLDOWN_SECONDS=300
STUDIO_REALTIME_WEBHOOK_ALLOWED_HOSTS=
# Browser files at or above this size use multipart; every non-final part is 8 MiB.
STUDIO_SOURCE_MULTIPART_THRESHOLD_BYTES=16777216
STUDIO_SOURCE_MULTIPART_PART_SIZE_BYTES=8388608
# Orphan preview scans only owner prefixes. Apply is bounded and requires an unchanged signed plan.
STUDIO_STORAGE_ORPHAN_MIN_AGE_SECONDS=86400
STUDIO_STORAGE_RECONCILIATION_SCAN_LIMIT=500
STUDIO_STORAGE_RECONCILIATION_PAGE_SIZE=100
STUDIO_STORAGE_RECONCILIATION_PLAN_TTL_SECONDS=600
STUDIO_STORAGE_RECONCILIATION_APPLY_LIMIT=100
# Scratch budget must fit worker tmpfs; processing reserves 64 MiB headroom.
STUDIO_AUDIO_PREPARATION_MAX_INPUT_BYTES=1073741824
STUDIO_AUDIO_PREPARATION_MAX_SCRATCH_BYTES=3221225472
STUDIO_REALTIME_DRAFT_MAX_COUNT=20
STUDIO_REALTIME_DRAFT_MAX_STORAGE_BYTES=33554432
STUDIO_AUDIO_PREPARATION_MAX_OUTPUT_BYTES=2147483647

# Google OAuth config. Values ending in _FILE are file paths only, not secret contents.
STUDIO_GOOGLE_OAUTH_CLIENT_ID=__REQUIRED_GOOGLE_OAUTH_CLIENT_ID__
STUDIO_YANDEX_DISK_OAUTH_CLIENT_ID=
STUDIO_YANDEX_DISK_OAUTH_CLIENT_SECRET_FILE=
STUDIO_GOOGLE_OAUTH_CLIENT_SECRET_FILE=
STUDIO_GOOGLE_OAUTH_REDIRECT_URI=https://studio.cloud-nodes.net/api/google/oauth/callback
STUDIO_GOOGLE_OAUTH_SCOPES=openid email https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/drive.readonly
STUDIO_GOOGLE_OAUTH_STATE_TTL_SECONDS=600

# Separate server-only Google OAuth grant for recursive transcript maintenance.
# Use a different OAuth client and secret file. These scopes must never reach the browser.
STUDIO_GOOGLE_MAINTENANCE_OAUTH_CLIENT_ID=__REQUIRED_GOOGLE_MAINTENANCE_OAUTH_CLIENT_ID__
STUDIO_GOOGLE_MAINTENANCE_OAUTH_CLIENT_SECRET_FILE=
STUDIO_GOOGLE_MAINTENANCE_OAUTH_REDIRECT_URI=https://studio.cloud-nodes.net/api/google/oauth/callback
STUDIO_GOOGLE_MAINTENANCE_OAUTH_SCOPES=openid email https://www.googleapis.com/auth/drive.metadata.readonly https://www.googleapis.com/auth/documents

STUDIO_GOOGLE_PICKER_API_KEY=__REQUIRED_PUBLIC_RESTRICTED_PICKER_API_KEY__
STUDIO_GOOGLE_PICKER_APP_ID=__REQUIRED_GOOGLE_CLOUD_PROJECT_NUMBER__

# Studio worker runtime controls. These are not secrets.
# Compose-enforced cgroup/PID/tmpfs limits. Memory and swap are intentionally
# equal so the worker cannot expand beyond the declared memory boundary.
STUDIO_WORKER_CPU_LIMIT=2.0
STUDIO_WORKER_MEMORY_LIMIT=4g
STUDIO_WORKER_MEMORY_SWAP_LIMIT=4g
STUDIO_WORKER_PIDS_LIMIT=256
STUDIO_WORKER_TMPFS_SIZE=3g
STUDIO_ELEVENLABS_SCRIBE_V2_RATE_PER_HOUR_USD=0.22
STUDIO_ELEVENLABS_PRICING_EFFECTIVE_DATE=2026-08-30
STUDIO_ELEVENLABS_PRICING_SOURCE=elevenlabs_public_api_pricing
# Optional nominal public USD tariff for Yandex asynchronous recognition.
# Leave all three empty if unverified; this never substitutes RUB/KZT or an invoice rate.
STUDIO_YANDEX_ASYNC_RATE_PER_HOUR_USD=
STUDIO_YANDEX_PRICING_EFFECTIVE_DATE=
STUDIO_YANDEX_PRICING_SOURCE=
STUDIO_WORKER_POLL_INTERVAL_SECONDS=5
STUDIO_WORKER_ERROR_BACKOFF_SECONDS=5
STUDIO_WORKER_LEASE_TTL_SECONDS=3600
STUDIO_WORKER_LEASE_HEARTBEAT_INTERVAL_SECONDS=60

# Durable owner-scoped operational incidents. Telegram is optional and remains
# disabled until both operator-managed secret file paths are supplied.
STUDIO_ALERT_EVALUATION_INTERVAL_SECONDS=60
STUDIO_ALERT_SIGNAL_WINDOW_SECONDS=900
STUDIO_ALERT_STUCK_QUEUE_SECONDS=900
# Non-secret personal owner UUID receiving missing/stale backup incidents.
# Match the host backup.env STUDIO_ALERT_OWNER_USER_ID; leave blank if not assigned.
STUDIO_BACKUP_MONITOR_OWNER_USER_ID=
STUDIO_ALERT_PROVIDER_FAILURE_THRESHOLD=3
STUDIO_ALERT_LIMIT_REMAINING_PERCENT=15
# Optional known quota for Studio-managed source/reference objects. Leave blank
# when the provider/account total cannot be established authoritatively.
STUDIO_ALERT_STORAGE_LIMIT_BYTES=
STUDIO_ALERT_INCIDENT_COOLDOWN_SECONDS=1800
STUDIO_ALERT_DELIVERY_RETRY_SECONDS=300
STUDIO_ALERT_DELIVERY_MAX_ATTEMPTS=3
STUDIO_ALERT_TELEGRAM_ENABLED=false
STUDIO_ALERT_TELEGRAM_BOT_TOKEN_FILE=
STUDIO_ALERT_TELEGRAM_CHAT_ID_FILE=
STUDIO_ALERT_TELEGRAM_TIMEOUT_SECONDS=5

# Owner-controlled terminal job notifications. Every channel is opt-in and
# remains unavailable in the UI until its server transport is fully configured.
STUDIO_JOB_NOTIFICATION_RETRY_SECONDS=60
STUDIO_JOB_NOTIFICATION_MAX_ATTEMPTS=3
STUDIO_JOB_NOTIFICATION_CLAIM_SECONDS=60
STUDIO_JOB_WEB_PUSH_ENABLED=false
STUDIO_JOB_WEB_PUSH_VAPID_PUBLIC_KEY=
STUDIO_JOB_WEB_PUSH_VAPID_PRIVATE_KEY_FILE=
STUDIO_JOB_WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
STUDIO_JOB_WEB_PUSH_TIMEOUT_SECONDS=5
STUDIO_JOB_EMAIL_ENABLED=false
STUDIO_JOB_SMTP_HOST=
STUDIO_JOB_SMTP_PORT=587
STUDIO_JOB_SMTP_USERNAME=
STUDIO_JOB_SMTP_PASSWORD_FILE=
STUDIO_JOB_SMTP_FROM_EMAIL=
STUDIO_JOB_SMTP_USE_SSL=false
STUDIO_JOB_SMTP_STARTTLS=true
STUDIO_JOB_SMTP_TIMEOUT_SECONDS=10
STUDIO_JOB_TELEGRAM_ENABLED=false
STUDIO_JOB_TELEGRAM_OWNER_USER_ID=
STUDIO_JOB_TELEGRAM_BOT_TOKEN_FILE=
STUDIO_JOB_TELEGRAM_CHAT_ID_FILE=
STUDIO_JOB_TELEGRAM_TIMEOUT_SECONDS=5
# UUID of the personal Studio owner whose audit trail receives host backup outcomes.
# Configure only in /etc/elevenlabs-studio/backup.env, not in the application .env.
# STUDIO_ALERT_OWNER_USER_ID=
